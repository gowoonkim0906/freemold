@{
	ViewData["Title"] = "로그인";
	Layout = "_Layout";
}


<div class="container container-tight py-4">

	<div class="text-center mb-4">
		<a href="." aria-label="Tabler" class="navbar-brand navbar-brand-autodark">
			<img src="https://www.freemold.net/Data/BannerImg/2023-12/45282_7236458333.png">
		</a>
	</div>
	


	<div class="card card-md">
		<div class="card-body">
			<h2 class="h2 text-center mb-4">프리몰드 관리자</h2>

			<form action="./" method="get" autocomplete="off" novalidate="">
				<div class="mb-3">
					<label class="form-label">ID</label>
					<input type="email" class="form-control" placeholder="아이디" autocomplete="off">
				</div>
				<div class="mb-2">
					<label class="form-label">
						Password
					</label>
					<div class="input-group input-group-flat">

						<input type="password" class="form-control" placeholder="패스워드" autocomplete="off">

						<span class="input-group-text">

							<a href="#" class="link-secondary" data-bs-toggle="tooltip" aria-label="Show password" data-bs-original-title="Show password">
								<!-- Download SVG icon from http://tabler.io/icons/icon/eye -->
								<svg xmlns="~/images/icon/eye.svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"></path></svg>
							</a>

						</span>

					</div>

				</div>

				<div class="form-footer">
					<button type="button" class="btn btn-primary w-100" onclick="location.href='/Banner';">
						Sign in
					</button>
				</div>
			</form>
		</div>

		
	</div>



</div>
