@{
    ViewData["Title"] = "배너관리";
    Layout = "_AdminLayout";
}


<div class="page-header d-print-none" aria-label="Page header">
	<div class="container-xl">
		<div class="row g-2 align-items-center">
			<div class="col">

				<h2 class="page-title">

					배너관리 > 배너검색
				</h2>


			</div>

		</div>
	</div>
</div>

<!-- END PAGE HEADER -->
<!-- BEGIN PAGE BODY -->
<div class="page-body">

	<div class="container-xl">

		<div class="row">
			<div class="col-12 col-lg-12">
                <div class="">
                    <div class="col mb-3">

                        <div class="ms-auto d-flex flex-wrap gap-2">
                            <div class="input-group input-group-flat w-auto">
                                <span class="input-group-text">
                                    <img src="~/images/icon/search.svg" width="20" height="20" />
                                </span>

                                <input id="companyname" name="companyname" type="text" class="form-control" autocomplete="off">

                            </div>

                            <button class="btn btn-0" onclick="companysearch()">검색</button>

                            <button class="btn btn-0" onclick="cleansearch()">초기화</button>

                            <div>
                                <select name="freetype" id="freetype" class="form-select" onchange="freesearch(this)">
                                    <option value="">유·무료 전체</option>
                                    <option value="f1">유료</option>
                                    <option value="f2">무료</option>
                                    <option value="f3">무료 메인신규</option>
                                    <option value="f4">무료 지사</option>
                                </select>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <a href="#" onclick="bannersearch(''); return false;" class="text-reset text-decoration-none">
                                    <span class="status-dot bg-dark me-2 status-dot-11"></span>
                                    전체<span id="btotal"></span>
                                </a>

                                <a href="#" onclick="bannersearch('d'); return false;" class="text-reset text-decoration-none">
                                    <span class="status-dot bg-red me-2 status-dot-11"></span>
                                    마감임박<span id="bdeadline"></span>
                                </a>

                                <a href="#" onclick="bannersearch('i'); return false;" class="text-reset text-decoration-none">
                                    <span class="status-dot bg-green me-2 status-dot-11"></span>
                                    운영중<span id="bing"></span>
                                </a>

                                <a href="#" onclick="bannersearch('r'); return false;" class="text-reset text-decoration-none">
                                    <span class="status-dot bg-blue me-2 status-dot-11"></span>
                                    예약<span id="breservation"></span>
                                </a>

                                <a href="#" onclick="bannersearch('w'); return false;" class="text-reset text-decoration-none">
                                    <span class="status-dot bg-yellow me-2 status-dot-11"></span>
                                    대기<span id="bwaiting"></span>
                                </a>

                            </div>
                            
                        </div>
                    </div>
                </div>
                <div class="card">

                    <div class="table-responsive">

                        <banner-search-data-list></banner-search-data-list>

                    </div>

                </div>
			</div>
		</div>
	</div>
</div>
<script>

    const bannerList =  document.querySelector("banner-search-data-list");

    function bannersearch(searchtype){

        // Lit 컴포넌트에 선택한 배너 전달
        const bannerList =  document.querySelector("banner-search-data-list");
    }

    function cleansearch(){
        
        $("#companyname").val('');
        $("#freetype").val('');

        bannerList.searchtype = "";
        bannerList.companyname = "";
        bannerList.searchfree = "";
        bannerList.page = 1;
        bannerList.getBannerList();
    }

    function companysearch(){
    
        const companyname = $("#companyname").val();

        if(!hasValue(companyname)){
        
            alert('업체명을 입력해주세요');
            return false;
        }

        bannerList.companyname = companyname;
        bannerList.page = 1;
        bannerList.getBannerList();
    }


    function bannersearch(searchtype){


        bannerList.searchtype = searchtype;
        bannerList.page = 1;
        bannerList.getBannerList();
    }
    

    function freesearch(e){

        bannerList.searchfree = e.value;
        bannerList.page = 1;
        bannerList.getBannerList();
    }

</script>