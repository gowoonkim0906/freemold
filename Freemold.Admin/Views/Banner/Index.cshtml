<div class="modal modal-blur fade"
	 id="positionbannermodal"
	 tabindex="-1"
	 role="dialog"
	 aria-labelledby="positionbannermodal-title"
	 aria-hidden="true"
	 data-bs-backdrop="static"
	 data-bs-keyboard="false">

	<div class="modal-dialog  modal-dialog-centered" role="document">

		<div class="modal-content" id="positionbannermodal-content">

			<!-- Ajax 내용 -->

		</div>

	</div>

</div>

<script>
	document.addEventListener("DOMContentLoaded", function () {

		const chartElement =
			document.getElementById("chart-banner-status");

		if (!chartElement || typeof ApexCharts === "undefined") {
			return;
		}

		const seriesData = [
			@paidbanner,
			@freebanner,
			@newfreebanner,
			@companyfreebanner
		];


		const totalCount = seriesData.reduce(function (a, b) { return a + b; }, 0);

		const chart = new ApexCharts(chartElement, {

			chart: {
				type: "donut",
				fontFamily: "inherit",
				height: 280,
				parentHeightOffset: 0,
				toolbar: {
					show: false
				}
			},

			series: seriesData,

			labels: [
				"유료",
				"무료",
				"무료_new",
				"무료_자사"
			],

			colors: [
				"#3b82f6",
				"#5ba4f5",
				"#34c99b",
				"#f59f00"
			],

			stroke: {
				width: 3,
				colors: ["#ffffff"]
			},

			dataLabels: {
				enabled: false
			},

			legend: {
				show: false
			},

			plotOptions: {

				pie: {

					expandOnClick: false,

					donut: {

						size: "70%",

						labels: {

							show: true,

							name: {
								show: true,
								offsetY: -8
							},

							value: {
								show: true,
								fontSize: "26px",
								fontWeight: 700,

								formatter: function (val) {
									return val + "건";
								}
							},

							total: {
								show: true,
								showAlways: true,
								label: "총 배너",

								fontSize: "14px",
								fontWeight: 600,

								formatter: function () {
									return totalCount + "건";
								}
							}

						}

					}

				}

			},

			tooltip: {

				y: {
					formatter: function (val) {
						return val + "건";
					}
				}

			}

		});

		chart.render();

	});

	function bannerpositionmodal() {

		

		$("#positionbannermodal-content").html("");

		const ajaxlink = '/Banner/AjaxBannerPositionModal';



		$.post(ajaxlink, '', function (html) {
			$('#positionbannermodal-content').html(html);
		});


		$('#positionbannermodal').modal('show');

	}

	function typelink(bccode) {
		var f = $('<form method="post" action="/Banner/Management"></form>');
		f.append($('<input type="hidden" name="searchbccode">').val(bccode));
		$('body').append(f);
		f.submit();
    }
</script>