<script>
	document.addEventListener("DOMContentLoaded", function () {

		const chartElement =
			document.getElementById("chart-banner-status");

		if (!chartElement || typeof ApexCharts === "undefined") {
			return;
		}

		const chart = new ApexCharts(chartElement, {

			chart: {
				type: "donut",
				fontFamily: "inherit",
				height: 280,
				parentHeightOffset: 0,
				toolbar: {
					show: false
				}
			},

			series: [
				45,
				25,
				20,
				10
			],

			labels: [
				"유료",
				"무료",
				"무료_new",
				"무료_자사"
			],

			colors: [
				"#3b82f6",
				"#5ba4f5",
				"#34c99b",
				"#f59f00"
			],

			stroke: {
				width: 3,
				colors: ["#ffffff"]
			},

			dataLabels: {
				enabled: false
			},

			legend: {
				show: false
			},

			plotOptions: {

				pie: {

					expandOnClick: false,

					donut: {

						size: "70%",

						labels: {

							show: true,

							name: {
								show: true,
								offsetY: -8
							},

							value: {
								show: true,
								fontSize: "26px",
								fontWeight: 700,

								formatter: function (val) {
									return val + "건";
								}
							},

							total: {
								show: true,
								showAlways: true,
								label: "총 배너",

								fontSize: "14px",
								fontWeight: 600,

								formatter: function () {
									return "100건";
								}
							}

						}

					}

				}

			},

			tooltip: {

				y: {
					formatter: function (val) {
						return val + "건";
					}
				}

			}

		});

		chart.render();

	});
</script>