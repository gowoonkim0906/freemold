@using Freemold.Modules.Models;
@{
	ViewData["Title"] = "배너관리";
	Layout = "_AdminLayout";


	var bannertotal = ViewBag.bannertotalcount as BannerTotalCountModel;
	var bannertypelist = ViewBag.bannertypelist as List<BannerTypeCountModel> ?? new List<BannerTypeCountModel>();
	var bcategorylist = ViewBag.bcategorylist as BannerCategoryCountModel;


	int totalbanner = 0;
	int regbanner = 0;
	int waitbanner = 0;
	int waitpricebanner = 0;
	int usebanner = 0;
	int usepricebanner = 0;
	int deadlinebanner = 0;
	int reservationbanner = 0;
	int reservationpricebanner = 0;
	int emptybanner = 0;

	int paidbanner = 0;
	int freebanner = 0;
	int newfreebanner = 0;
	int companyfreebanner = 0;

	string deadlinerate = "0";
	string userate = "0";
	string reservationrate = "0";
	string waitrate = "0";
	string emptyrate = "0";

	

	if (bannertotal != null)
	{
		totalbanner = bannertotal.typetotal;
		regbanner = bannertotal.typereg;
		waitbanner = bannertotal.typewait;
		waitpricebanner = bannertotal.typewaitprice;
		usebanner = bannertotal.typeuse;
		usepricebanner = bannertotal.typeuseprice;
		deadlinebanner = bannertotal.typedeadline;
		reservationbanner = bannertotal.typereservation;
		reservationpricebanner = bannertotal.typereservationprice;
		emptybanner = bannertotal.typeempty;

		paidbanner = bannertotal.paidbanner;
		freebanner = bannertotal.freebanner;
		newfreebanner = bannertotal.newfreebanner;
		companyfreebanner = bannertotal.companyfreebanner;


		deadlinerate = totalbanner == 0 ? "0" : ((double)deadlinebanner / totalbanner * 100).ToString("N2");
		userate = totalbanner == 0 ? "0" : ((double)usebanner / totalbanner * 100).ToString("N2");
		reservationrate = totalbanner == 0 ? "0" : ((double)reservationbanner / totalbanner * 100).ToString("N2");
		waitrate = totalbanner == 0 ? "0" : ((double)waitbanner / totalbanner * 100).ToString("N2");
		emptyrate = totalbanner == 0 ? "0" : ((double)emptybanner / totalbanner * 100).ToString("N2");

	}
}
