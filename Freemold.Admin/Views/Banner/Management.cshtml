@using Freemold.Modules.Models;
@{
    ViewData["Title"] = "배너관리";
    Layout = "_AdminLayout";

    var list = ViewBag.bannerlist as List<BannerSettingModel> ?? new List<BannerSettingModel>();
    var list2 = ViewBag.bannercategorylist as List<BannerSettingCategoryModel> ?? new List<BannerSettingCategoryModel>();

    var groups = list.GroupBy(b => new { b.bccode, b.bcname, b.bcord })
                .OrderBy(g => g.Key.bcord)
                .ToList();



}

<div class="page-header d-print-none" aria-label="Page header">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">

                <h2 class="page-title">

                    배너관리 > 영역별 관리
                </h2>


            </div>

        </div>
    </div>
</div>

<!-- END PAGE HEADER -->
<!-- BEGIN PAGE BODY -->
<div class="page-body">

    <div class="container-xl">

        <!-- =====================================
             상단 라인
        ====================================== -->
        <div class="row g-3 align-items-center mb-3">

            <!-- 왼쪽 제목 -->
            <div class="col-12 col-lg-2">

                <h3 class="mb-0">
                    배너 영역 및 타입
                </h3>

            </div>


            <!-- 오른쪽 상태 + 버튼 -->
            <div class="col-12 col-lg-10">

                <div class="d-flex align-items-center flex-wrap gap-3">

                    <a href="#" onclick="bannersearch(''); return false;" class="text-reset text-decoration-none">
                        <span class="status-dot bg-dark me-2 status-dot-11"></span>
                        전체<span id="btotal"></span>
                    </a>

                    <a href="#" onclick="bannersearch('d'); return false;" class="text-reset text-decoration-none">
                        <span class="status-dot bg-red me-2 status-dot-11"></span>
                        마감임박<span id="bdeadline"></span>
                    </a>

                    <a href="#" onclick="bannersearch('i'); return false;" class="text-reset text-decoration-none">
                        <span class="status-dot bg-green me-2 status-dot-11"></span>
                        운영중<span id="bing"></span>
                    </a>

                    <a href="#" onclick="bannersearch('r'); return false;" class="text-reset text-decoration-none">
                        <span class="status-dot bg-blue me-2 status-dot-11"></span>
                        예약<span id="breservation"></span>
                    </a>

                    <a href="#" onclick="bannersearch('w'); return false;" class="text-reset text-decoration-none">
                        <span class="status-dot bg-yellow me-2 status-dot-11"></span>
                        대기<span id="bwaiting"></span>
                    </a>

                    <span>
                        <span class="status-dot bg-gray me-2 status-dot-11"></span>
                        공석<span id="bvacant"></span>
                    </span>


                    <!-- 오른쪽 끝 -->
                    <div class="ms-auto d-flex align-items-center gap-2">

                        <span class="me-2" id="bannersize">
                            <span id="bannersize"></span>
                        </span>

                        <button type="button" class="btn btn-blue" onclick="bannersetmodal(0)">
                            배너등록
                        </button>

                        <button type="button" class="btn btn-danger" onclick="bannerdelete(0)">
                            선택삭제
                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================
             실제 내용
        ====================================== -->
        <div class="row g-3">

            <!-- LEFT -->
            <div class="col-12 col-lg-2">

                <div class="card banner-type-menu">

                    <div class="list-group list-group-flush">

                        @foreach (var group in groups)
                        {
                            var groupId = group.Key.bccode;
                            var items = group
                                        .OrderBy(x => x.ord1)
                                        .ThenBy(x => x.ord2)
                                        .ToList();


                            <div class="list-group-item bg-gray-100 fw-bold">

                                <a href="#@(groupId)"
                                   class="d-flex align-items-center text-reset text-decoration-none"
                                   data-bs-toggle="collapse"
                                   aria-expanded="false">

                                    <span>
                                        @(group.Key.bcname)
                                    </span>

                                    <span class="ms-auto">
                                        +
                                    </span>

                                </a>

                            </div>

                            <div class="collapse" id="@groupId">

                            @for (int i = 0; i < items.Count; i++)
                            {
                                var item = items[i];

                                    <a href="#" onclick="bannerdatalist(this)" data-banneridx="@(item.banneridx)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <span>@item.bannername</span>

                                        <div class="d-flex gap-1">
                                            @if (item.bdeadline > 0)
                                            {
                                                <span class="d-flex align-items-center gap-1 text-red">
                                                    <span class="status-dot bg-red status-dot-11"></span>
                                                    <small>@item.bdeadline</small>
                                                </span>
                                            }

                                            @if (item.breservation > 0)
                                            {
                                                <span class="d-flex align-items-center gap-1 text-blue">
                                                    <span class="status-dot bg-blue status-dot-11"></span>
                                                    <small>@item.breservation</small>
                                                </span>
                                            }

                                            @if (item.bwaiting > 0)
                                            {
                                                <span class="d-flex align-items-center gap-1 text-yellow">
                                                    <span class="status-dot bg-yellow status-dot-11"></span>
                                                    <small>@item.bwaiting</small>
                                                </span>
                                            }

                                            @if ((item.bannercnt - item.bing) != 0)
                                            {
                                                <span class="d-flex align-items-center gap-1 text-gray">
                                                    <span class="status-dot bg-gray status-dot-11"></span>
                                                    <small>@(item.bannercnt - item.bing)</small>
                                                </span>
                                            }


                                        </div>
                                    </a>

                            }
                            </div>
                        }
                        

                        @if (list2.Any())
                        {
                            <div class="list-group-item bg-gray-100 fw-bold">

                                <a href="#BC007"
                                   class="d-flex align-items-center text-reset text-decoration-none"
                                   data-bs-toggle="collapse">

                                    <span>
                                        카테고리배너
                                    </span>

                                    <span class="ms-auto">
                                        +
                                    </span>

                                </a>

                            </div>

                            <div class="collapse" id="BC007">

                                @foreach (var item in list2)
                                {
                                    <a href="#" class="list-group-item list-group-item-action">
                                        @(item.catname)
                                    </a>

                                }

                            </div>
                        
                        }

                        

                    </div>

                </div>

            </div>


            <!-- RIGHT -->
            <div class="col-12 col-lg-10">

                <div class="card">

                    <div class="table-responsive">

                        <banner-data-list></banner-data-list>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="modal modal-blur fade"
     id="setbannermodal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="setbannermodal-title"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">

        <div class="modal-content" id="setbannermodal-content">

            <!-- Ajax 내용 -->

        </div>

    </div>

</div>
<script>

    let banneridx = 0;

    function bannersetmodal(idx) {

        if(banneridx <= 0){
        
            alert('배너선택후 이용해주세요.');
            return;
        }

        $("#setbannermodal-content").html("");

        const ajaxlink = 'AjaxSetBannerModal';


        var param = {
            banneridx : banneridx,
            idx : idx
        };

        $.post(ajaxlink, param, function (html) {
            $('#setbannermodal-content').html(html);
        });


        $('#setbannermodal').modal('show');

    }


    function bannerdatalist(e){

        banneridx = e.dataset.banneridx;
        

        // 왼쪽 메뉴 선택 표시
        document.querySelectorAll(
            ".banner-type-menu .list-group-item-action"
        ).forEach(item => {
            item.classList.remove("active");
        });

        e.classList.add("active");


        // Lit 컴포넌트에 선택한 배너 전달
        const bannerList =  document.querySelector("banner-data-list");

        if (bannerList) {
            bannerList.selectBanner(banneridx ,1 , 10, '');
            bannerdatacnt();
        }

        //return false;
    }

    function bannersearch(searchtype){
    
        // Lit 컴포넌트에 선택한 배너 전달
        const bannerList =  document.querySelector("banner-data-list");

        if (bannerList) {
            bannerList.selectBanner(banneridx ,1 , 10, searchtype);
            bannerdatacnt(banneridx);
        }
    }


    function bannerdatacnt(){
    
        $.ajax({
                url: "/Banner/AjaxGetBannerCnt",
                type: "POST",
                dataType: "json",
                data: {
                    bidx: banneridx
                },
                success: function (data) {

                    if (data && data.items) {

                        const item = data.items

                        $("#btotal").html(` ${item.btotal}`);
                        $("#bdeadline").html(` ${item.bdeadline}`);
                        $("#bing").html(` ${item.bing}`);
                        $("#breservation").html(` ${item.breservation}`);
                        $("#bwaiting").html(` ${item.bwaiting}`);
                        $("#bvacant").html(` ${item.bvacant}`);
                        $("#bannersize").html(`배너 사이즈 : ${item.bannersizex}*${item.bannersizey}`);
                        
                     
                    } else {
                        console.error("배너 카운트 조회 실패");
                    }
                    
                },
                error: function (xhr, status) {
                    if (status === "abort") return;

                    console.error(xhr.responseText);

                    $select.empty().append(
                        new Option("검색 오류", "")
                    );
                }
           })
    }

    function bannerdelete(){

        const bannerList =  document.querySelector("banner-data-list");
        const $checkedItems = $('input[name="uniqueidx"]:checked');

        if ($checkedItems.length === 0) {
            alert('삭제할 배너를 선택해주세요.');
            return false;
        }

        const arr = [];
        $checkedItems.each(function() {
            arr.push($(this).val());
        });

        if (!confirm(arr.length + "개의 배너를 삭제하시겠습니까?")) {
            return false;
        }


        $.ajax({
            url: '/Banner/AjaxDeleteTypeBanner',
            type: 'POST',
            dataType: "json",
            data: { 
                idx: arr ,
                deleteyn: "Y",
                memberId: "freemold",
                regIp : "127.0.0.1"
            },
            success: function(data) {
                if (data.items === "success") {

                alert("삭제되었습니다.");

                bannerList.selectBanner(banneridx ,1 , 10, '');
                bannerdatacnt();

            } else {
                alert("삭제에 실패했습니다.");
            }
            },
            error: function (xhr, status) {
                
            }
        });

        console.log(chkList);
    }


</script>