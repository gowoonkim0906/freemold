                data-bs-target="#sidebar-menu"
                aria-controls="sidebar-menu"
                aria-expanded="false"
                aria-label="메뉴 열기">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- ==========================================
             로고 + PC 접기 버튼
             ========================================== -->
        <div class="admin-sidebar-header">

            <!-- 로고 -->
            <div class="navbar-brand navbar-brand-autodark admin-sidebar-logo">

                <a href="/Banner" aria-label="프리몰드">

                    <!--
                        이 아이콘은 항상 보임
                    -->
                    
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 512 512">
                        <rect fill="#E05D38" x="0" y="0" width="512" height="512" rx="96" ry="96" />
                        <path fill="#FFFFFF" d="M 338 107.5 H 282 C 255 107.5 245 118 245 142 V 191 H 338 V 253 H 245 V 458 H 176 V 253 H 128 V 191 H 176 V 142 C 176 80 216 54 282 54 H 338 V 107.5 Z" />
                    </svg>

                    <!--
                        접으면 이 글씨만 숨김
                    -->
                    <span class="admin-logo-text text-orange">
                        프리몰드
                    </span>

                </a>

            </div>


            <!-- PC용 접기/펼치기 버튼 -->
            <button type="button"
                    id="adminSidebarToggle"
                    class="btn btn-icon admin-sidebar-toggle d-none d-lg-inline-flex"
                    title="메뉴 접기"
                    aria-label="메뉴 접기">

                <!-- 삼선 -->
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M4 6h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 18h16"></path>

                </svg>

            </button>

